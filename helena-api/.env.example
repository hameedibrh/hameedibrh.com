LLM_API_KEY=...
LLM_MODEL=...
# Required — the client is OpenAI-compatible, and its default endpoint won't accept this key.
LLM_BASE_URL=...

# Rate limiting (required — the API refuses all requests with 503 if unset).
# Free tier at https://upstash.com — create a Redis database, copy these from its REST API tab.
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...
